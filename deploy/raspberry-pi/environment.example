# Electronic Scrabble Raspberry Pi console configuration.

ELECTRONIC_SCRABBLE_DATA_DIR=/var/lib/electronic-scrabble/games
ELECTRONIC_SCRABBLE_CONSOLE_CONTROL=1
ELECTRONIC_SCRABBLE_HTTP_HOST=0.0.0.0
ELECTRONIC_SCRABBLE_HTTP_PORT=8000
ELECTRONIC_SCRABBLE_SYSTEMCTL_PATH=/usr/bin/systemctl
ELECTRONIC_SCRABBLE_SUDO_PATH=/usr/bin/sudo

# Autonomous Wi-Fi access point. The configure-access-point script writes these
# values automatically. Do not publish a real console password in Git.
# ELECTRONIC_SCRABBLE_WIFI_ACCESS_POINT=1
# ELECTRONIC_SCRABBLE_WIFI_CONNECTION=electronic-scrabble-ap
# ELECTRONIC_SCRABBLE_WIFI_INTERFACE=wlan0
# ELECTRONIC_SCRABBLE_WIFI_SSID=ElectronicScrabble
# ELECTRONIC_SCRABBLE_WIFI_PASSWORD=ChangeThisPassword
# ELECTRONIC_SCRABBLE_WIFI_ADDRESS=10.42.0.1/24
# ELECTRONIC_SCRABBLE_PUBLIC_BASE_URL=http://10.42.0.1:8000
# ELECTRONIC_SCRABBLE_PUBLIC_ADDRESS=192.168.1.50

# Word validation remains optional until an authorized dictionary is supplied.
# ELECTRONIC_SCRABBLE_DICTIONARY_MODE=required
# ELECTRONIC_SCRABBLE_DICTIONARY_PATH=/var/lib/electronic-scrabble/dictionary/authorized-words.txt
# ELECTRONIC_SCRABBLE_DICTIONARY_NAME=Authorized French dictionary
# ELECTRONIC_SCRABBLE_WORD_VALIDATION_POLICY=challenge

# Online FFSc ODS 9 checker (requires Internet access):
# ELECTRONIC_SCRABBLE_DICTIONARY_MODE=ffsc
# ELECTRONIC_SCRABBLE_DICTIONARY_NAME="FFSc ODS 9 online"
# ELECTRONIC_SCRABBLE_FFSC_TIMEOUT_MS=5000
